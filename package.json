{
  "name": "ths-cmc-mcp",
  "version": "1.0.0",
  "description": "MCP server that turns live CoinMarketCap data into a sourced token health brief. Every risk flag cites the CMC field and value.",
  "type": "module",
  "bin": { "ths-cmc": "src/cli.ts" },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx tests/live-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["mcp", "coinmarketcap", "crypto", "token", "risk", "agent"],
  "license": "MIT",
  "author": "Gabriel Mangabeira"
}
